{
  "name": "omniverse-desktop",
  "version": "2.1.79",
  "description": "The ultimate, ultra-premium media player and discovery desktop app. Zero ads, zero trackers, pure native performance.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "debug": "electron . --omni-debug",
    "test": "node --test test/*.test.js",
    "test:security": "node --test test/security.test.js",
    "security:check": "npm audit --omit=dev --audit-level=high && npm run test:security",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "FiNiX <finix@omniverse.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiNiX-GaMmA/omniverse.git"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.finix.omniverse.desktop",
    "productName": "Omniverse",
    "publish": null,
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "adShieldStats.js",
      "macUpdater.js",
      "preload.js",
      "securityPolicy.js",
      "traktAuth.js",
      "index.html",
      "renderer.js",
      "qrcode.min.js",
      "style.css",
      "logo.png"
    ],
    "mac": {
      "identity": null,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "logo.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Omniverse",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Video;AudioVideo;Player;",
      "icon": "logo.png"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.1",
    "cross-fetch": "^4.1.0",
    "playwright": "^1.61.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
