# ==============================================================================
# Omniverse — Industry-Standard Native Git Ignore Rules
# ==============================================================================

# System / macOS / OS Files
.DS_Store
**/.DS_Store
Thumbs.db

# General / Miscellaneous
*.log
*.class
*.pyc
*.swp
.atom/
.history
.svn/
.vscode/
.claude/

# Node.js / Desktop Packager Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/

# Temporary screenshots and automation testing dumps
/screen.png
/screen_*.png
/window_dump.xml

# IntelliJ / Android Studio Files
*.iml
*.ipr
*.iws
.idea/
**/local.properties

# Gradle & Android Build Outputs
.gradle/
**/.gradle/
build/
**/build/
capture/
**/app/debug/
**/app/profile/
**/app/release/
*.apk
*.aar
*.dex
*.class

# Android signing material (keep local; CI restores it from repository secrets)
/android/keystore.properties
/keystore/*.jks
/keystore/*.keystore

# Xcode & iOS Build Outputs
ios/build/
**/ios/build/
ios/build_device/
ios/build_mac/
**/build_device/
ios/DerivedData/
**/DerivedData/
**/*.xcworkspace/
**/*.xcuserstate
**/*.xcuserdatad
**/*.xcresult/
**/Payload/

# Flutter / Legacy (kept for safety)
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/
*.png

# Local Android SDK
/android/sdk/

# graphify Outputs & Caches
graphify-out/cache/
graphify-out/transcripts/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_incremental.json
graphify-out/.graphify_old.json
graphify-out/.graphify_semantic_new.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_chunk_*.json
graphify-out/cost.json
graphify-out/20??-??-??/
